#!/usr/bin/env python3
"""xshelld - serves the shell UI on 127.0.0.1:8081 and exposes launch + .deb store APIs.
Every POST needs the per-boot token (only the shell page contains it), the exact Origin and Host."""
import configparser, glob, json, os, re, secrets, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

WEB = os.environ.get("XSHELL_WEB", "/usr/share/xshell")
PORT = int(os.environ.get("XSHELL_PORT", "8081"))
TOKEN = secrets.token_hex(16)
PKG = re.compile(r"^[a-z0-9][a-z0-9+.\-]{1,100}$")
QRY = re.compile(r"^[A-Za-z0-9+.\- ]{2,40}$")
URL = re.compile(r"^https?://[^\s]+$")


def apps():
    out = {}
    for f in glob.glob("/usr/share/applications/*.desktop") + glob.glob(os.path.expanduser("~/.local/share/applications/*.desktop")):
        c = configparser.RawConfigParser(strict=False, interpolation=None)
        try:
            c.read(f, encoding="utf-8")
            s = c["Desktop Entry"]
            if s.get("Type") != "Application" or s.get("NoDisplay", "").lower() == "true" or s.get("Hidden", "").lower() == "true":
                continue
            out[os.path.basename(f)] = {"id": os.path.basename(f), "name": s.get("Name", os.path.basename(f))}
        except Exception:
            continue
    return sorted(out.values(), key=lambda a: a["name"].lower())


def spawn(cmd):
    subprocess.run(["swaymsg", "workspace", "number", "2"], capture_output=True)
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def out(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path == "/health":
            return self.out(200, {"ok": True})
        if self.path in ("/", "/index.html"):
            html = open(os.path.join(WEB, "index.html"), encoding="utf-8").read().replace("__TOKEN__", TOKEN)
            return self.out(200, html.encode(), "text/html; charset=utf-8")
        self.out(404, {"error": "not found"})

    def do_POST(self):
        h = self.headers
        if (h.get("Host") != f"127.0.0.1:{PORT}" or h.get("Origin") != f"http://127.0.0.1:{PORT}"
                or not secrets.compare_digest(h.get("X-Token", ""), TOKEN)):
            return self.out(403, {"error": "forbidden"})
        try:
            d = json.loads(self.rfile.read(min(int(h.get("Content-Length", 0)), 4096)) or b"{}")
        except Exception:
            return self.out(400, {"error": "bad request"})
        p = self.path
        if p == "/api/apps":
            return self.out(200, apps())
        if p == "/api/launch":
            if d.get("cmd") == "foot":
                spawn(["foot"])
            elif d.get("id") in {a["id"] for a in apps()}:
                spawn(["gtk-launch", d["id"]])
            elif "url" in d and (d["url"] == "" or URL.match(d["url"])):
                spawn(["firefox-esr", "--new-window", d["url"] or "http://home.app.local/"])
            else:
                return self.out(400, {"error": "bad target"})
            return self.out(200, {"ok": True})
        if p == "/api/refresh":
            r = subprocess.run(["sudo", "-n", "apt-get", "update"], capture_output=True, text=True, timeout=300)
            return self.out(200, {"ok": r.returncode == 0})
        if p == "/api/search":
            q = str(d.get("q", "")).strip()
            if not QRY.match(q):
                return self.out(200, [])
            r = subprocess.run(["apt-cache", "search", *q.split()], capture_output=True, text=True, timeout=60)
            res = []
            for ln in r.stdout.splitlines()[:25]:
                n, _, desc = ln.partition(" - ")
                res.append({"name": n, "desc": desc})
            return self.out(200, res)
        if p == "/api/install":
            pkg = str(d.get("pkg", ""))
            if not PKG.match(pkg):
                return self.out(400, {"ok": False})
            r = subprocess.run(["sudo", "-n", "apt-get", "install", "-y", "--", pkg], capture_output=True, text=True, timeout=1800)
            return self.out(200, {"ok": r.returncode == 0, "log": r.stdout[-400:] + r.stderr[-400:]})
        self.out(404, {"error": "not found"})


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
