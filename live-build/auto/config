#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc,grub-efi" \
  --debian-installer none \
  --archive-areas "main contrib non-free-firmware" \
  --iso-application "XFCE Proxy OS" \
  --iso-volume "XFCEPROXY" \
  --bootappend-live "boot=live components quiet splash hostname=xfceproxy username=user" \
  "${@}"
